# Gemini API key — SERVER-SIDE ONLY (Netlify Function env var).
# Get a key: https://aistudio.google.com/apikey
# Add it in Netlify: Site settings → Environment variables → GEMINI_API_KEY
# (do NOT use a VITE_ prefix — that would bake it into the public bundle).
# Then redeploy. Optional: GEMINI_MODELS="gemini-3.8-flash,gemini-2.0-flash"
GEMINI_API_KEY=your_api_key_here
# GEMINI_MODELS=gemini-3.8-flash
